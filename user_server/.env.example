# Database Configuration (REQUIRED)
SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:5432/your-database?sslmode=require
SPRING_DATASOURCE_USERNAME=your-username
SPRING_DATASOURCE_PASSWORD=your-password

# JWT Configuration (REQUIRED)
JWT_SECRET=your-secret-key-at-least-32-characters-long

# JWT Configuration (Optional - defaults provided)
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=90

# Email Configuration (REQUIRED)
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password

# Email Configuration (Optional - defaults provided)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587

# Business Configuration (Optional - defaults provided)
BOOKING_WINDOW_DAYS=60
FARE_PER_KM=2.5
